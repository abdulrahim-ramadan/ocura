/* Built from ocura.ui.theme.Tokens. Every value here is a token placeholder;
   if you find yourself typing a literal colour or pixel size, add a token. */

QWidget {{
    background: {bg};
    color: {text};
    font-family: {font_family};
    font-size: {font_size_m};
}}

QMainWindow, #Root {{
    background: {bg};
}}

/* Labels inherit QWidget's background and would otherwise paint a page-coloured
   box over whatever surface they sit on. */
QLabel {{
    background: transparent;
}}

/* --- navigation ------------------------------------------------------- */

#Sidebar {{
    background: {surface};
    border-right: 1px solid {border};
}}

#Wordmark {{
    color: {text};
    font-size: {font_size_l};
    padding: {space_sm} {space_sm} {space_xs} {space_sm};
}}

#Tagline {{
    color: {text_faint};
    font-size: {font_size_s};
    padding: 0 {space_sm} {space_lg} {space_sm};
}}

/* Selection is a tint and a thin edge. The accent marks the current section; it
   does not announce it. Both states carry the 2px edge so the label never
   shifts sideways when it is chosen. */
#NavButton {{
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: {radius_s};
    color: {text_muted};
    font-size: {font_size_m};
    padding: {space_s} {space_sm};
    text-align: left;
}}

#NavButton:hover {{
    background: {nav_selected};
    color: {text};
}}

#NavButton:checked {{
    background: {nav_selected};
    border-left: 2px solid {accent};
    color: {text};
}}

/* --- cards ------------------------------------------------------------ */

#Card {{
    background: {surface};
    border: 1px solid {border};
    border-radius: {radius_l};
}}

#Headline {{
    color: {text};
    font-size: {font_size_xl};
}}

#Display {{
    color: {text};
    font-size: {font_size_display};
}}

#Detail {{
    color: {text_muted};
    font-size: {font_size_m};
}}

#SectionTitle {{
    color: {text_faint};
    font-size: {font_size_s};
}}

#Metric {{
    color: {text};
    font-size: {font_size_xl};
}}

#MetricLabel {{
    color: {text_faint};
    font-size: {font_size_s};
}}

#WaitingNote {{
    background: {accent_quiet};
    border: none;
    border-left: 2px solid {accent};
    border-radius: {radius_s};
    color: {text_muted};
    font-size: {font_size_m};
    padding: {space_s} {space_m};
}}

#Placeholder {{
    color: {text_muted};
    font-size: {font_size_m};
}}

/* --- controls --------------------------------------------------------- */

QPushButton {{
    background: {surface_raised};
    border: 1px solid {border};
    border-radius: {radius_m};
    color: {text};
    padding: {space_s} {space_m};
}}

QPushButton:hover {{
    border-color: {accent};
}}

QPushButton:disabled {{
    color: {text_faint};
    border-color: {border};
}}

QPushButton#Primary {{
    background: {accent};
    border: 1px solid {accent};
    color: {accent_text};
}}

QPushButton#Primary:disabled {{
    background: {accent_quiet};
    border-color: {accent_quiet};
    color: {text_faint};
}}

QProgressBar {{
    background: {surface_raised};
    border: none;
    border-radius: {radius_s};
    max-height: 6px;
    min-height: 6px;
    text-align: center;
}}

QProgressBar::chunk {{
    background: {accent};
    border-radius: {radius_s};
}}

/* --- event list ------------------------------------------------------- */

#EventList {{
    background: transparent;
    border: none;
    color: {text_muted};
    font-size: {font_size_s};
}}

#EventList::item {{
    padding: {space_xs} 0;
}}

#EventList::item:selected {{
    background: transparent;
    color: {text};
}}

QScrollBar:vertical {{
    background: transparent;
    border: none;
    width: 8px;
}}

QScrollBar::handle:vertical {{
    background: {border};
    border-radius: {radius_s};
    min-height: 24px;
}}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{
    height: 0;
}}

/* --- pre-break toast --------------------------------------------------- */

#Toast {{
    background: {surface_raised};
    border: 1px solid {border};
    border-radius: {radius_l};
}}

#ToastHeadline {{
    color: {text};
    font-size: {font_size_l};
}}

#ToastDetail {{
    color: {text_muted};
    font-size: {font_size_m};
}}

#ToastAction {{
    background: transparent;
    border: 1px solid {border};
    border-radius: {radius_m};
    color: {text_muted};
    padding: {space_xs} {space_sm};
}}

#ToastAction:hover {{
    border-color: {accent};
    color: {text};
}}

/* --- break overlay ------------------------------------------------------ */

#Overlay, #BreakScreen {{
    background: {overlay_bg};
}}

/* Read back from the palette by the custom paintEvent, so the shape's colour
   is a token like everything else rather than a literal in Python. */
#FocusShape {{
    color: {overlay_shape};
}}

#BreakMessage {{
    color: {overlay_text};
    font-size: {font_size_xl};
}}

#BreakCountdown {{
    color: {overlay_text_faint};
    font-size: {font_size_m};
}}

#BreakAction {{
    background: transparent;
    border: 1px solid {overlay_shape};
    border-radius: {radius_m};
    color: {overlay_text_faint};
    padding: {space_s} {space_m};
}}

#BreakAction:hover, #BreakAction:focus {{
    border-color: {overlay_text};
    color: {overlay_text};
}}
