/* Built from ocura.ui.theme.Tokens. Every value here is a token placeholder;
   if you find yourself typing a literal colour or pixel size, add a token. */

QWidget {{
    background: {bg};
    color: {text};
    font-family: {font_family};
    font-size: {font_size_m};
}}

QMainWindow, #Root {{
    background: {bg};
}}

/* Labels inherit QWidget's background and would otherwise paint a page-coloured
   box over whatever surface they sit on. */
QLabel {{
    background: transparent;
}}

/* --- navigation ------------------------------------------------------- */

#Sidebar {{
    background: {surface};
    border-right: 1px solid {border};
}}

#Wordmark {{
    color: {text};
    font-size: {font_size_l};
    padding: {space_sm} {space_sm} {space_xs} {space_sm};
}}

#Tagline {{
    color: {text_faint};
    font-size: {font_size_s};
    padding: 0 {space_sm} {space_lg} {space_sm};
}}

/* Selection is a tint and a thin edge. The accent marks the current section; it
   does not announce it. Both states carry the 2px edge so the label never
   shifts sideways when it is chosen. */
#NavButton {{
    background: transparent;
    border: none;
    border-left: 2px solid transparent;
    border-radius: {radius_s};
    color: {text_muted};
    font-size: {font_size_m};
    padding: {space_s} {space_sm};
    text-align: left;
}}

#NavButton:hover {{
    background: {nav_selected};
    color: {text};
}}

#NavButton:checked {{
    background: {nav_selected};
    border-left: 2px solid {accent};
    color: {text};
}}

/* --- cards ------------------------------------------------------------ */

#Page, #Page > QWidget > QWidget, #Content {{
    background: transparent;
}}

#Card {{
    background: {surface};
    border: 1px solid {border};
    border-radius: {radius_l};
}}

#Headline {{
    color: {text};
    font-size: {font_size_xl};
}}

#Display {{
    color: {text};
    font-size: {font_size_display};
}}

#Detail {{
    color: {text_muted};
    font-size: {font_size_m};
}}

#SectionTitle {{
    color: {text_faint};
    font-size: {font_size_s};
}}

#Metric {{
    color: {text};
    font-size: {font_size_xl};
}}

#MetricLabel {{
    color: {text_faint};
    font-size: {font_size_s};
}}

#WaitingNote {{
    background: {accent_quiet};
    border: none;
    border-left: 2px solid {accent};
    border-radius: {radius_s};
    color: {text_muted};
    font-size: {font_size_m};
    padding: {space_s} {space_m};
}}

#Placeholder {{
    color: {text_muted};
    font-size: {font_size_m};
}}

/* --- statistics ------------------------------------------------------- */

/* The bars are painted by ocura.ui.statistics.Bar, which reads this colour
   back off its palette. Same route as the break overlay's shape: no colour is
   written in Python, so a theme is still only this file plus the tokens. */
#Bar {{
    color: {chart_bar};
}}

/* Today, marked the way the sidebar marks the current section. Not a verdict
   on the day — there are no good and bad days on this page. */
#TodayBar {{
    color: {accent};
}}

/* The deferral proportions. The accent, because this is the section the page
   exists for, and every row carries it equally. */
#ReasonBar {{
    color: {accent};
}}

#BarValue {{
    color: {text_faint};
    font-size: {font_size_s};
}}

#BarLabel {{
    color: {text_muted};
    font-size: {font_size_s};
}}

#BarLabelToday {{
    color: {text};
    font-size: {font_size_s};
}}

#BarDate {{
    color: {text_faint};
    font-size: {font_size_s};
}}

#ReasonLabel {{
    color: {text};
    font-size: {font_size_m};
}}

#ReasonCount {{
    color: {text_muted};
    font-size: {font_size_m};
}}

/* --- settings --------------------------------------------------------- */

#SettingTitle {{
    color: {text};
    font-size: {font_size_m};
}}

#SettingNote {{
    color: {text_muted};
    font-size: {font_size_s};
}}

/* A refused value. Marked the way a waiting note is — an edge and a tint, no
   alarm colour — because it is a correction, not a fault. The text is at full
   strength rather than muted: it is the one sentence on the page that has to
   be read. */
#SettingProblem {{
    background: {accent_quiet};
    border: none;
    border-left: 2px solid {accent};
    border-radius: {radius_s};
    color: {text};
    font-size: {font_size_s};
    padding: {space_s} {space_m};
}}

#SettingSpin, #SettingChoice {{
    background: {surface_raised};
    border: 1px solid {border};
    border-radius: {radius_m};
    color: {text};
    min-width: 96px;
    padding: {space_xs} {space_s};
}}

/* A checkbox is the control here, so it gets a real box rather than whatever
   the platform style draws over a dark surface. */
#SettingToggle::indicator {{
    background: {surface_raised};
    border: 1px solid {border};
    border-radius: {radius_s};
    height: 16px;
    width: 16px;
}}

#SettingToggle::indicator:hover {{
    border-color: {accent};
}}

#SettingToggle::indicator:checked {{
    background: {accent};
    border-color: {accent};
}}

#SettingToggle::indicator:disabled {{
    background: {surface};
    border-color: {border};
}}

#SettingSpin:focus, #SettingChoice:focus {{
    border-color: {accent};
}}

#SettingChoice::drop-down {{
    border: none;
    width: {space_lg};
}}

#SettingChoice QAbstractItemView {{
    background: {surface_raised};
    border: 1px solid {border};
    color: {text};
    selection-background-color: {accent_quiet};
    selection-color: {text};
}}

#SettingToggle {{
    color: {text};
    font-size: {font_size_m};
    spacing: {space_s};
}}

#SettingToggle:disabled {{
    color: {text_faint};
}}

/* --- controls --------------------------------------------------------- */

QPushButton {{
    background: {surface_raised};
    border: 1px solid {border};
    border-radius: {radius_m};
    color: {text};
    padding: {space_s} {space_m};
}}

QPushButton:hover {{
    border-color: {accent};
}}

QPushButton:disabled {{
    color: {text_faint};
    border-color: {border};
}}

QPushButton#Primary {{
    background: {accent};
    border: 1px solid {accent};
    color: {accent_text};
}}

QPushButton#Primary:disabled {{
    background: {accent_quiet};
    border-color: {accent_quiet};
    color: {text_faint};
}}

QProgressBar {{
    background: {surface_raised};
    border: none;
    border-radius: {radius_s};
    max-height: 6px;
    min-height: 6px;
    text-align: center;
}}

QProgressBar::chunk {{
    background: {accent};
    border-radius: {radius_s};
}}

/* --- event list ------------------------------------------------------- */

#EventList {{
    background: transparent;
    border: none;
    color: {text_muted};
    font-size: {font_size_s};
}}

#EventList::item {{
    padding: {space_xs} 0;
}}

#EventList::item:selected {{
    background: transparent;
    color: {text};
}}

QScrollBar:vertical {{
    background: transparent;
    border: none;
    width: 8px;
}}

QScrollBar::handle:vertical {{
    background: {border};
    border-radius: {radius_s};
    min-height: 24px;
}}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {{
    height: 0;
}}

/* --- pre-break toast --------------------------------------------------- */

#Toast {{
    background: {surface_raised};
    border: 1px solid {border};
    border-radius: {radius_l};
}}

#ToastHeadline {{
    color: {text};
    font-size: {font_size_l};
}}

#ToastDetail {{
    color: {text_muted};
    font-size: {font_size_m};
}}

#ToastAction {{
    background: transparent;
    border: 1px solid {border};
    border-radius: {radius_m};
    color: {text_muted};
    padding: {space_xs} {space_sm};
}}

#ToastAction:hover {{
    border-color: {accent};
    color: {text};
}}

/* --- break overlay ------------------------------------------------------ */

#Overlay, #BreakScreen {{
    background: {overlay_bg};
}}

/* Read back from the palette by the custom paintEvents, so the shape and the
   cue take their colour from a token like everything else rather than from a
   literal in Python. */
#FocusShape {{
    color: {overlay_shape};
}}

#BlinkCue {{
    color: {overlay_cue};
}}

/* The instruction. The one thing on the screen meant to be read, and sized
   accordingly — presence comes from the type scale, not from luminance. */
#BreakMessage {{
    color: {overlay_text};
    font-size: {font_size_xxl};
}}

/* Secondary information. Anyone who wants the number can find it; nobody
   needs to watch it. */
#BreakCountdown {{
    color: {overlay_text_muted};
    font-size: {font_size_s};
}}

/* Tertiary, and deliberately not tiny: a control too small to look intentional
   reads as an accident rather than as a choice the user is offered. */
#BreakAction {{
    background: transparent;
    border: 1px solid {overlay_shape};
    border-radius: {radius_m};
    color: {overlay_text_muted};
    font-size: {font_size_s};
    padding: {space_sm} {space_lg};
}}

#BreakAction:hover, #BreakAction:focus {{
    border-color: {overlay_text_muted};
    color: {overlay_text};
}}

/* The faintest thing on the screen. It is evidence, offered to whoever goes
   looking for it, and it must never pull the eye back down to the display. */
#BreakTip {{
    color: {overlay_text_faint};
    font-size: {font_size_s};
}}
